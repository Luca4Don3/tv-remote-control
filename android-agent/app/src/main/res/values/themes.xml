<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fixed dark theme for the 10-foot TV UI. -->
    <style name="Theme.TvRemote" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/tvrc_primary</item>
        <item name="colorPrimaryVariant">@color/tvrc_primary_container</item>
        <item name="colorOnPrimary">@color/tvrc_on_primary</item>
        <item name="colorSecondary">@color/tvrc_primary</item>
        <item name="colorSecondaryVariant">@color/tvrc_primary_container</item>
        <item name="colorOnSecondary">@color/tvrc_on_primary</item>
        <item name="colorSurface">@color/tvrc_surface</item>
        <item name="colorOnSurface">@color/tvrc_on_surface</item>
        <item name="colorError">@color/tvrc_error</item>
        <item name="android:colorBackground">@color/tvrc_bg</item>
        <item name="android:windowBackground">@color/tvrc_bg</item>
        <item name="android:textColorPrimary">@color/tvrc_on_surface</item>
        <item name="android:textColorSecondary">@color/tvrc_muted</item>
        <item name="android:textColorHint">@color/tvrc_muted</item>
        <item name="colorControlHighlight">@color/tvrc_focus_overlay</item>
    </style>

    <style name="TvRemote.SectionTitle" parent="">
        <item name="android:textColor">@color/tvrc_on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TvRemote.Body" parent="">
        <item name="android:textColor">@color/tvrc_on_surface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TvRemote.Muted" parent="">
        <item name="android:textColor">@color/tvrc_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TvRemote.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/tvrc_button_stroke</item>
        <item name="android:textColor">@color/tvrc_button_text</item>
        <item name="backgroundTint">@color/tvrc_button_bg</item>
    </style>

    <style name="TvRemote.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/tvrc_button_bg_primary</item>
        <item name="android:textColor">@color/tvrc_button_text_primary</item>
    </style>

    <style name="TvRemote.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/tvrc_surface</item>
        <item name="strokeColor">@color/tvrc_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
