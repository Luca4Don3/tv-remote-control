.page {
  padding: 40rpx;
}

.status {
  color: #9aa3ad;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.status.ok {
  color: #6fe38b;
}

.status.bad {
  color: #f6685c;
}

.pad {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.key {
  background: #1b2027;
  color: #e8eaed;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 8rpx 0;
}

.key[disabled] {
  opacity: 0.4;
}

.commit {
  margin-top: 24rpx;
}

.foot {
  margin-top: 48rpx;
}

.secondary {
  background: #2a3038;
}
