<view class="page">
  <view class="hint">与 Debug 构建 agent 的调试通道配对（明文 WS + PSK 端到端加密，仅限开发环境）。</view>

  <view class="label">Agent IP</view>
  <input class="input" value="{{host}}" bindinput="onHostInput" placeholder="192.168.1.x" />

  <view class="label">调试端口（默认 47833）</view>
  <input class="input" type="number" value="{{port}}" bindinput="onPortInput" />

  <view class="label">controllerId（32 位十六进制）</view>
  <input class="input" value="{{controllerId}}" bindinput="onControllerIdInput" placeholder="由 agent 配对页提供" />

  <view class="label">PSK（64 位十六进制）</view>
  <input class="input" password value="{{pskHex}}" bindinput="onPskInput" placeholder="由 agent 导出（P3）或手动录入" />

  <view class="actions">
    <button class="btn" bindtap="onSave">保存凭据</button>
    <button class="btn" bindtap="onTest">连接并遥控</button>
    <button class="btn secondary" bindtap="onClear">清除</button>
  </view>

  <view wx:if="{{saved}}" class="status">已保存凭据：{{host}}:{{port}}</view>
</view>
